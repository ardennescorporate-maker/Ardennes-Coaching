# ─── Supabase ────────────────────────────────────────────────
# Hosted: Project Settings → API. Local: `supabase start` prints these,
# or run scripts/dev-supabase/setup.sh (Docker-free) which fills them in.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (only used by scripts/tests)
DATABASE_URL=

# Public URL of this app (used for auth redirects and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI (server only) ────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_STRONG=claude-sonnet-5-5
# Set to 1 to return canned AI responses (no API calls) — handy for local dev and tests
AI_MOCK=

# ─── Auth providers ──────────────────────────────────────────
NEXT_PUBLIC_AUTH_GOOGLE=0
# Apple needs an Apple Developer account; keep 0 until configured in Supabase.
NEXT_PUBLIC_AUTH_APPLE=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Beta / admin ────────────────────────────────────────────
# Comma-separated emails that are made admins when they sign up.
ADMIN_EMAILS=ardennescorporate@gmail.com
# Shows "Explore with the demo student" on the login page (never enable in production)
NEXT_PUBLIC_DEMO_MODE=1

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="StudyPilot <hello@studypilot.app>"

# ─── Web push (generate with `npx web-push generate-vapid-keys`) ─
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ardennescorporate@gmail.com

# ─── Scheduled jobs ──────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/*
CRON_SECRET=

# ─── Payments (after beta) ───────────────────────────────────
BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_EXAM=

# ─── Monitoring ──────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DASHBOARD_URL=
